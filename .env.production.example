# ==========================================
# WAHA-NoWeb-Light Production Environment Configuration (AWS EC2)
# ==========================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Security: Master API Key for backend communication (Django -> WAHA)
WAHA_API_KEY=replace_with_strong_production_api_key_64chars

# HTTP Basic Auth credentials for UI Dashboard (prevents unauthorized browser access)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace_with_strong_admin_password_2026
WAHA_DASHBOARD_AUTH=true

# Public Base URL (Used for media links and QR codes)
WAHA_BASE_URL=https://waha.yourdomain.com

# WhatsApp Client Identity (Shown in WhatsApp Linked Devices screen)
WAHA_CLIENT_DEVICE_NAME=MarketIntel-Production

# Webhook-First Integration & Cryptographic Security
# Change this to your production backend webhook endpoint
WHATSAPP_HOOK_URL=https://api.yourdomain.com/api/whatsapp/webhook/
WHATSAPP_HOOK_EVENTS=*
WHATSAPP_HOOK_SECRET=replace_with_strong_hmac_secret_sha512

# Auto-start default session so QR code is pushed immediately upon boot
WHATSAPP_START_SESSION=default

# Structured Logging
WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
