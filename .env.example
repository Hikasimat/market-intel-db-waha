# ==========================================
# WAHA-NoWeb-Light Configuration
# ==========================================

# Port and Network Binding
PORT=3000
HOST=0.0.0.0

# Optional API Security (Blocks unauthorized direct calls to WAHA API)
# WAHA_API_KEY=waha_secure_api_key_2026

# HTTP Basic Auth on UI Dashboard (prevents unauthorized browser access)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=waha_secure_api_key_2026

# Client Device Identity (Shown in WhatsApp Linked Devices)
WAHA_CLIENT_DEVICE_NAME=WAHA-Light

# Base URL for local resources and webhook generation
WAHA_BASE_URL=http://localhost:3000

# Storage Locations (relative to project root or absolute paths)
WAHA_SESSIONS_DIR=./.sessions
WHATSAPP_FILES_FOLDER=./.media

# Structured Logging (PRETTY for local dev, JSON for production)
WAHA_LOG_FORMAT=PRETTY
WAHA_LOG_LEVEL=info

# Webhook-First Integration & Cryptographic Security
# All events (QR code, pairing code, status, messages, acks) pushed to your server
WHATSAPP_HOOK_URL=http://localhost:8000/api/whatsapp/webhook/
WHATSAPP_HOOK_EVENTS=*
WHATSAPP_HOOK_SECRET=waha_super_secret_hmac_key_2026
WHATSAPP_START_SESSION=default
